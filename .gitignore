# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/

# Large Datasets & Model Binaries (tracked by DVC)
/data/*
!/data/.gitkeep
/models/*
!/models/.gitkeep

# DVC Internal Storage Cache
.dvc/cache
.dvc/tmp

# Environment & Secrets
.env
*.env.local

# Database Volumes & System Dumps
postgres_data/
.DS_Store
*.swp
*~
